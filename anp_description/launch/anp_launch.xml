<launch>

    <let
        name="anp_urdf_path"
        value="$(find-pkg-share anp_description)/urdf/anp.urdf.xacro" />

    <let
        name="bridge_config_path"
        value="$(find-pkg-share anp_bringup)/config/anp_gazebo_bridge.yaml" />
        
    <let name="world"
       value="$(find-pkg-share anp_gazebo)/worlds/hospital_world.sdf"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
    	<param name="use_sim_time" value="true"/>
    	<param name="robot_description" value="$(command 'xacro $(var anp_urdf_path)')" />
    </node>

    <include
        file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg
            name="gz_args"
            value="-r -v2 $(var world)" /> 
        <arg 
            name="on_exit_shutdown"
            value="true"/>
    </include>

    <node
        pkg="ros_gz_sim"
        exec="create"
        args="-topic robot_description -name ANP_bot"
        output="screen" />

    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        args="--ros-args -p config_file:=$(var bridge_config_path)"
        output="screen" />

    <node
        pkg="controller_manager"
        exec="spawner"
        args="joint_state_broadcaster --controller-manager /controller_manager"
        output="screen" />

    <node
        pkg="controller_manager"
        exec="spawner"
        args="diff_drive_controller --controller-manager /controller_manager"
        output="screen" />
        

    <node
    pkg="rviz2"
    exec="rviz2"
    output="screen"
/>
    
    <set_env
    name="GZ_SIM_RESOURCE_PATH"
    value="$(find-pkg-share anp_gazebo)/worlds"/>

</launch>
