<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_radius" value="0.30"/>
    <xacro:property name="base_height" value="0.15"/>
    <xacro:property name="wheel_radius" value="0.10"/>
    <xacro:property name="wheel_length" value="0.05"/>
    <xacro:property name="caster_radius" value="0.045"/>
    <xacro:property name="caster_width" value="0.04"/>
    <xacro:property name="caster_trail" value="0.03"/>
    <xacro:property name="caster_mount_height" value="0.04"/>
    <xacro:property name="caster_mount_width" value="0.04"/>
    <xacro:property name="wheel_y_offset" value="${base_radius + wheel_length / 2 + 0.01}"/>
    <xacro:property name="sensor_y_offset" value="0.08"/>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
                <material name="red"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
            </collision>
            <xacro:cylinder_inertia m="0.1" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi / 2} 0 0"/>
        </link>
    </xacro:macro>

    <xacro:macro name="caster" params="prefix x y">
        <link name="${prefix}_caster_mount">
            <visual>
                <geometry>
                    <box size="${caster_mount_width} ${caster_mount_width} ${caster_mount_height}"/>
                </geometry>
                <origin xyz="0 0 ${-caster_mount_height / 2}" rpy="0 0 0"/>
                <material name="gray"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${caster_mount_width} ${caster_mount_width} ${caster_mount_height}"/>
                </geometry>
                <origin xyz="0 0 ${-caster_mount_height / 2}" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="0.08"/>
                <origin xyz="0 0 ${-caster_mount_height / 2}" rpy="0 0 0"/>
                <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
            </inertial>
        </link>

        <link name="${prefix}_caster_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${caster_radius}" length="${caster_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${caster_radius}" length="${caster_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
            </collision>
            <inertial>
                <mass value="0.08"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0000826" ixy="0" ixz="0" iyy="0.000144" iyz="0" izz="0.0000826"/>
            </inertial>
        </link>

        <joint name="${prefix}_caster_swivel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_caster_mount"/>
            <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <joint name="${prefix}_caster_wheel_joint" type="continuous">
            <parent link="${prefix}_caster_mount"/>
            <child link="${prefix}_caster_wheel"/>
            <origin xyz="${-caster_trail} 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="${base_radius}" length="${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${base_radius}" length="${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
            <inertia ixx="0.024375" ixy="0" ixz="0" iyy="0.024375" iyz="0" izz="0.045"/>
        </inertial>
    </link>

    <xacro:wheel_link prefix="front_left"/>
    <xacro:wheel_link prefix="front_right"/>

    <xacro:caster prefix="rear_left" x="-0.22" y="0.14"/>
    <xacro:caster prefix="rear_right" x="-0.22" y="-0.14"/>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius / 2}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius / 2}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.05" r="${wheel_radius / 2}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:base_inertia m="0.05" x="0.1" y="0.1" z="0.1" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0 ${wheel_y_offset} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0 ${-wheel_y_offset} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 ${sensor_y_offset} ${base_height + 0.05}" rpy="0 0 0"/>
    </joint>

    <joint name="base_imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 ${-sensor_y_offset} ${base_height + 0.05}" rpy="0 0 0"/>
    </joint>>

</robot>
